#!/bin/bash
# Bootstrap the Datadog Agent with Workload Protection on a plain Docker host.
# Follows https://docs.datadoghq.com/security/workload_protection/setup/agent/docker/
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive

# DPkg::Lock::Timeout waits for unattended-upgrades to release the dpkg lock
# rather than failing, which it otherwise does routinely in the first minutes
# of a fresh boot.
apt_get() {
  apt-get -o DPkg::Lock::Timeout=600 "$@"
}

apt_get update
apt_get install -y curl unzip docker.io
systemctl enable --now docker

# Ubuntu 24.04 dropped the awscli package, so install AWS CLI v2 from AWS
# directly. `uname -m` already yields the architecture strings AWS publishes
# (x86_64, aarch64).
curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m).zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install
rm -rf /tmp/awscliv2.zip /tmp/aws

# The key is never written to user-data; it is fetched at boot with the
# instance's own role and passed straight to the container.
# Tracing is off for this block so the key does not land in the cloud-init log.
set +x
DD_API_KEY="$(/usr/local/bin/aws ssm get-parameter \
  --region "${region}" \
  --name "${api_key_path}" \
  --with-decryption \
  --query Parameter.Value \
  --output text)"
export DD_API_KEY
set -x

# Passed by name, not by value, so the key stays out of the traced command line.

docker run -d --name ${agent_container} \
  --restart unless-stopped \
  --cgroupns host \
  --pid host \
  --security-opt apparmor:unconfined \
  --cap-add SYS_ADMIN \
  --cap-add SYS_RESOURCE \
  --cap-add SYS_PTRACE \
  --cap-add NET_ADMIN \
  --cap-add NET_BROADCAST \
  --cap-add NET_RAW \
  --cap-add IPC_LOCK \
  --cap-add CHOWN \
  -v /var/run/docker.sock:/var/run/docker.sock:ro \
  -v /proc/:/host/proc/:ro \
  -v /sys/fs/cgroup/:/host/sys/fs/cgroup:ro \
  -v /etc/passwd:/etc/passwd:ro \
  -v /etc/group:/etc/group:ro \
  -v /:/host/root:ro \
  -v /sys/kernel/debug:/sys/kernel/debug \
  -v /etc/os-release:/etc/os-release \
  -e DD_API_KEY \
  -e DD_SITE="${datadog_site}" \
  -e HOST_ROOT=/host/root \
  -e DD_COMPLIANCE_CONFIG_ENABLED=true \
  -e DD_COMPLIANCE_CONFIG_HOST_BENCHMARKS_ENABLED=true \
  -e DD_RUNTIME_SECURITY_CONFIG_ENABLED=true \
  -e DD_RUNTIME_SECURITY_CONFIG_REMOTE_CONFIGURATION_ENABLED=true \
  "${agent_image}"
